<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        Le champ "Ligne d'annuaire" (fr_directory_line_id) doit rester
        modifiable quel que soit l'état de la facture. On doit modifier la
        vue qui hérite directement de l10n_fr_einvoicing.view_move_form
        (et non account.view_move_form) car ce champ n'existe pas encore
        dans l'arbre d'héritage à ce niveau.
    -->
    <record id="view_move_form_fr_directory_line_diffuse" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_fr_einvoicing.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fr_directory_line_id'][1]" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
            <xpath expr="//field[@name='company_fr_directory_line_id']" position="attributes">
                <attribute name="readonly">move_type in ('in_invoice', 'in_refund') or (move_type in ('out_invoice', 'out_refund') and state not in ('draft', 'diffuse'))</attribute>
            </xpath>
        </field>
    </record>
</odoo>
