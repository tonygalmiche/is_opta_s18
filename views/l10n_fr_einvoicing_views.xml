<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!--
        is_opta_s18 ajoute un état intermédiaire 'diffuse' avant 'posted'
        (cf. account_invoice_view.xml : le bouton "Valider" n'est visible
        qu'à l'état 'diffuse'). Le champ fr_directory_line_id de
        l10n_fr_einvoicing est obligatoire dès que fr_einvoicing_required
        est vrai, mais reste en lecture seule dès que l'état n'est plus
        'draft' : il faut donc aussi l'autoriser en écriture à l'état
        'diffuse' pour pouvoir le renseigner avant de cliquer sur "Valider".
    -->
    <record id="view_move_form_fr_directory_line_diffuse" model="ir.ui.view">
        <field name="model">account.move</field>
        <field name="inherit_id" ref="l10n_fr_einvoicing.view_move_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='fr_directory_line_id'][1]" position="attributes">
                <attribute name="readonly">state not in ('draft', 'diffuse')</attribute>
            </xpath>
            <xpath expr="//field[@name='company_fr_directory_line_id']" position="attributes">
                <attribute name="readonly">move_type in ('in_invoice', 'in_refund') or (move_type in ('out_invoice', 'out_refund') and state not in ('draft', 'diffuse'))</attribute>
            </xpath>
        </field>
    </record>
</odoo>
